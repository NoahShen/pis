# PIS private environment template. Copy outside the repository and chmod 600.
# Replace every example value. The application does not auto-load this file.

HOST=127.0.0.1
PORT=3000
API_TOKEN=replace-with-a-strong-independent-token
LOG_LEVEL=info
DATABASE_PATH=/srv/pis/data/pis.sqlite

PIS_LLM_ENDPOINT=https://llm.example.invalid/v1/chat/completions
PIS_LLM_API_KEY=replace-with-real-private-llm-key
PIS_LLM_MODEL=replace-with-real-model
PROMPTS_DIR=/srv/pis/prompts

RSS_SSRF_PROTECTION=true
CRON_TIMEZONE=Asia/Shanghai

# Optional GitHub Pages publishing. Leave all Pages variables unset to disable it.
# RSS_PAGES_REPOSITORY=git@github.com:<OWNER>/<REPO>.git
# RSS_PAGES_BRANCH=main
# RSS_PAGES_WORK_DIRECTORY=/srv/pis/data/rss-pages
# RSS_PAGES_PUBLIC_ORIGIN=https://<OWNER>.github.io/<REPO>
# RSS_PAGES_PUBLIC_DIRECTORY=<one-random-directory>
# RSS_PAGES_PUBLISH_TIMEOUT_MS=120000
# RSS_PAGES_POLL_INTERVAL_MS=5000
