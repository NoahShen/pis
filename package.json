{
  "name": "pis",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "26.13.1",
    "npm": "11.20.0"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "26.13.1",
      "onFail": "error"
    },
    "packageManager": {
      "name": "npm",
      "version": "11.20.0",
      "onFail": "error"
    }
  },
  "packageManager": "npm@11.20.0",
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run",
    "build": "npm run clean && tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "smoke": "npm run build && npm run smoke:run",
    "smoke:run": "node scripts/smoke.mjs",
    "verify:toolchain": "node scripts/verify-toolchain.mjs",
    "format": "node scripts/format.mjs --write",
    "format:check": "node scripts/format.mjs --check",
    "verify": "npm run verify:toolchain && npm run typecheck && npm test && npm run build && npm run smoke && npm run format:check"
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "26.6.6",
    "prettier": "3.10.1",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  },
  "dependencies": {
    "better-sqlite3": "13.2.0",
    "fastify": "5.12.8",
    "pino": "10.4.0",
    "zod": "4.6.7"
  }
}
